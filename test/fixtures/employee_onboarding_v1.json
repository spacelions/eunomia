{
  "schema_version": "v1",
  "workflow_id": "internal-employee-onboarding",
  "version": 1,
  "name": "Internal Employee Onboarding",
  "description": "Provisions Google Workspace account, collects AI tool preferences, and syncs the Notion onboarding tracker.",
  "owner": "role:people_ops",
  "trigger": {
    "archetype": "requestor",
    "input_keys": ["employee_name", "personal_email"]
  },
  "state": {
    "employee_name": {
      "type": "string",
      "description": "Full name of the new hire"
    },
    "personal_email": {
      "type": "email",
      "description": "Personal email used before company account exists"
    },
    "desired_prefix": {
      "type": "string",
      "description": "Preferred username prefix before @spacelions.com"
    },
    "work_email": {
      "type": "email",
      "description": "Provisioned Google Workspace email"
    },
    "temp_password": {
      "type": "string",
      "description": "One-time temporary Google Workspace password",
      "sensitive": true
    },
    "ai_tools": {
      "type": "string_list",
      "options": ["gemini", "claude"],
      "description": "Requested AI coding/productivity tools"
    },
    "provision_notes": {
      "type": "string",
      "description": "Receipt notes from IT Ops after provisioning AI tools"
    }
  },
  "root": {
    "id": "onboarding_root",
    "name": "Employee Onboarding Flow",
    "type": "sequence",
    "sequence": {
      "steps": [
        {
          "id": "pick_email",
          "name": "Pick Company Email",
          "type": "interaction",
          "interaction": {
            "archetype": "ground_truth_provider",
            "channel": "gmail",
            "assignee": "state.personal_email",
            "allow_delegate": false,
            "prompt": {
              "expr": "'Hi ' + state.employee_name + ', choose your preferred Space Lions email prefix.'"
            },
            "fields": [
              {
                "state_key": "desired_prefix",
                "label": "Desired Email Prefix",
                "required": true,
                "validators": [
                  {
                    "connector": "google_workspace",
                    "validator": "username_available"
                  }
                ]
              }
            ],
            "sla": {
              "reminder_after": "24h",
              "escalate_after": "48h"
            },
            "escalate_to": "role:it_ops"
          }
        },
        {
          "id": "provision_google_user",
          "name": "Provision Google Workspace User",
          "type": "action",
          "action": {
            "connector": "google_workspace",
            "operation": "create_user",
            "inputs": {
              "full_name": { "expr": "state.employee_name" },
              "username_prefix": { "expr": "state.desired_prefix" },
              "recovery_email": { "expr": "state.personal_email" }
            },
            "outputs": {
              "work_email": "primary_email",
              "temp_password": "temporary_password"
            }
          }
        },
        {
          "id": "send_temp_credentials",
          "name": "Email Temporary Credentials",
          "type": "action",
          "action": {
            "connector": "google_workspace",
            "operation": "send_email",
            "recipient": "state.personal_email",
            "inputs": {
              "subject": { "literal": "Your Space Lions Google Workspace Account" },
              "work_email": { "expr": "state.work_email" },
              "temp_password": { "expr": "state.temp_password" }
            }
          }
        },
        {
          "id": "ai_tools_survey",
          "name": "AI Tools Access Survey",
          "type": "interaction",
          "interaction": {
            "archetype": "ground_truth_provider",
            "channel": "gmail",
            "assignee": "state.work_email",
            "allow_delegate": false,
            "prompt": {
              "literal": "Select which AI tools you need provisioned."
            },
            "fields": [
              {
                "state_key": "ai_tools",
                "label": "AI Tools",
                "required": true
              }
            ],
            "sla": {
              "reminder_after": "24h",
              "escalate_after": "48h"
            },
            "escalate_to": "role:it_ops"
          }
        },
        {
          "id": "provision_ai_tools_branch",
          "name": "Provision Requested AI Tools",
          "type": "switch",
          "switch": {
            "cases": [
              {
                "when": "len(state.ai_tools) > 0",
                "node": {
                  "id": "manual_ai_provisioning",
                  "name": "Provision AI Tools (IT Ops)",
                  "type": "interaction",
                  "interaction": {
                    "archetype": "fulfiller",
                    "channel": "gmail",
                    "assignee": "role:it_ops",
                    "prompt": {
                      "expr": "'Provision AI tools for ' + state.work_email + ': ' + join(state.ai_tools, ', ')"
                    },
                    "receipt_fields": [
                      {
                        "state_key": "provision_notes",
                        "label": "Provisioning Notes",
                        "required": false
                      }
                    ],
                    "sla": {
                      "reminder_after": "24h",
                      "escalate_after": "48h"
                    },
                    "escalate_to": "workflow.owner"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "closeout_notifications",
          "name": "Sync Tracker & Notify Initiator",
          "type": "parallel",
          "parallel": {
            "branches": [
              {
                "id": "sync_notion_tracker",
                "name": "Upsert Notion Onboarding Tracker",
                "type": "action",
                "action": {
                  "archetype": "observer",
                  "connector": "notion",
                  "operation": "upsert_db_row",
                  "resources": {
                    "database": "onboarding_tracker"
                  },
                  "inputs": {
                    "employee_name": { "expr": "state.employee_name" },
                    "work_email": { "expr": "state.work_email" },
                    "ai_tools": { "expr": "state.ai_tools" },
                    "status": { "literal": "Onboarded" }
                  }
                }
              },
              {
                "id": "notify_initiator",
                "name": "Send Onboarding Summary",
                "type": "action",
                "action": {
                  "archetype": "observer",
                  "connector": "google_workspace",
                  "operation": "send_email",
                  "recipient": "run.initiator",
                  "inputs": {
                    "subject": { "expr": "'Onboarding complete: ' + state.employee_name" },
                    "work_email": { "expr": "state.work_email" },
                    "provision_notes": { "expr": "state.provision_notes" }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}
