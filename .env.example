# =============================================================================
# REQUIRED — Eunomia fails fast at boot if either of these is missing/invalid
# =============================================================================

# PostgreSQL connection string
EUNOMIA_DATABASE_URL=postgres://postgres@127.0.0.1:54329/eunomia?sslmode=disable

# Master keyring for envelope-encrypting tenant_secrets in Postgres.
# Format: comma-separated "<key_id>:<base64-32-byte-key>" pairs (first = active key).
# Generate one with: go run ./cmd/eunomia secret keygen
# (In local dev, `nix develop` auto-generates a gitignored .dev/master.key if unset.)
EUNOMIA_MASTER_KEYS=

# =============================================================================
# Runtime Defaults
# =============================================================================
EUNOMIA_GRPC_ADDR=127.0.0.1:8080
EUNOMIA_TEMPORAL_ADDR=127.0.0.1:7233
EUNOMIA_TEMPORAL_NAMESPACE=default
EUNOMIA_TEMPORAL_TASK_QUEUE=eunomia
EUNOMIA_DEFAULT_TENANT=spacelions

# =============================================================================
# LLM Provider (v0.1: DeepSeek API — required when running ADK Compiler)
# =============================================================================
DEEPSEEK_API_KEY=
